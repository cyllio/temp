# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA faça commit do .env.local — ele já está no .gitignore.
# Em produção (Vercel), configure estas mesmas variáveis em:
# Project Settings > Environment Variables (não versionar aqui).

# E-mail da Service Account do Google Cloud (IAM > Contas de serviço)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Chave privada da Service Account (campo "private_key" do JSON baixado).
# Mantenha as quebras de linha como \n (uma única linha no .env).
GOOGLE_PRIVATE_KEY=

# ID da planilha "Rateio Presentes" (encontrado na URL do Google Sheets:
# https://docs.google.com/spreadsheets/d/ESTE_TRECHO/edit)
GOOGLE_SHEET_ID=

# Nome da aba dentro da planilha (opcional, padrão "Sheet1")
GOOGLE_SHEET_TAB=Sheet1

# Chave de API do Resend (https://resend.com/api-keys), usada para o botão
# "Enviar e-mail aos pendentes". Sem isso, o botão retorna erro mas o resto do app funciona.
RESEND_API_KEY=

# E-mail remetente verificado no Resend (ex: cobranca@seudominio.com)
RESEND_FROM_EMAIL=
